REPORT zsra_student_db.

DATA: gt_students TYPE STANDARD TABLE OF zsra_student
                   WITH DEFAULT KEY,
      gs_student  TYPE zsra_student.

DATA: lv_existing_id TYPE zsra_student-student_id,
      lv_inserted    TYPE i VALUE 0,
      lv_duplicate   TYPE i VALUE 0.

* Student 1
CLEAR gs_student.
gs_student-student_id   = '10001'.
gs_student-student_name = 'Shannu'.
gs_student-department   = 'CSE'.
gs_student-age          = 20.
gs_student-marks        = '85.50'.

APPEND gs_student TO gt_students.

* Student 2
CLEAR gs_student.
gs_student-student_id   = '10002'.
gs_student-student_name = 'Bhanu'.
gs_student-department   = 'CSE'.
gs_student-age          = 20.
gs_student-marks        = '91.00'.

APPEND gs_student TO gt_students.

* Student 3
CLEAR gs_student.
gs_student-student_id   = '10003'.
gs_student-student_name = 'Zayar'.
gs_student-department   = 'ECE'.
gs_student-age          = 22.
gs_student-marks        = '78.50'.

APPEND gs_student TO gt_students.

* Check duplicate student IDs

LOOP AT gt_students INTO gs_student.

  CLEAR lv_existing_id.

  SELECT SINGLE student_id
    FROM zsra_student
    INTO @lv_existing_id
    WHERE student_id = @gs_student-student_id.

  IF sy-subrc = 0.

    lv_duplicate = lv_duplicate + 1.

    WRITE: / 'Duplicate ID:', gs_student-student_id,
             '- Record already exists.'.

  ELSE.

    INSERT zsra_student FROM @gs_student.

    IF sy-subrc = 0.
      lv_inserted = lv_inserted + 1.
      WRITE: / 'Student inserted:', gs_student-student_id.
    ELSE.
      WRITE: / 'Insertion failed:', gs_student-student_id.
    ENDIF.

  ENDIF.

ENDLOOP.

IF lv_inserted > 0.
  COMMIT WORK.
ENDIF.

* Display database records

CLEAR gt_students.

SELECT *
  FROM zsra_student
  INTO TABLE @gt_students.

ULINE.
WRITE: / 'STUDENT DATABASE RECORDS'.
ULINE.

LOOP AT gt_students INTO gs_student.

  WRITE: / gs_student-student_id,
           gs_student-student_name,
           gs_student-department,
           gs_student-age,
           gs_student-marks.

ENDLOOP.

ULINE.

WRITE: / 'Total Records:', lines( gt_students ).
WRITE: / 'New Records Inserted:', lv_inserted.
WRITE: / 'Duplicate Records Skipped:', lv_duplicate.
